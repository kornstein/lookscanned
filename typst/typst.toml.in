[package]
name = "lookscanned"
version = "@VERSION@"
compiler = "0.14.0"
entrypoint = "lib.typ"
authors = ["Célestin Besson"]
license = "Apache-2.0"
description = "Make documents look scanned, photocopied, faxed or typewritten, powered by WASM."
keywords = ["scan", "photocopy", "fax", "typewriter", "paper", "texture", "vintage"]
categories = ["visualization"]
exclude = ["thumbnail.png"]
